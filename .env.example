# ── Digital Teras — variabel lingkungan ──────────────────────────────────────
# Salin ke .env.local (dev) dan isi kredensial proyek Supabase-mu.
# Untuk Supabase CLI lokal (supabase start): URL http://localhost:54321,
# key keyless/anon bisa diambil dari output `supabase start`.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...anon-key

# Hanya dipakai di server (lib/supabase/admin.ts) — JANGAN kirim ke klien.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role-key

# ── Midtrans (Milestone 7) ───────────────────────────────────────────────────
# Sandbox: MIDTRANS_IS_PAID_MODE=false (default), key dari dashboard Midtrans
# → Allowances → SB-Keys. Production: MIDTRANS_IS_PAID_MODE=true + key live.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PAID_MODE=false
# Opsional utk uji webhook via tunnel (mis. cloudflared/ngrok):
#   MIDTRANS_WEBHOOK_BASE=https://xxxx.trycloudflare.com
# Notifikasi juga bisa di-set global di dashboard Midtrans → Web Settings.
MIDTRANS_WEBHOOK_BASE=
